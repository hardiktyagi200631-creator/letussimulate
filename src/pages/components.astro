---
import MainLayout from '../layouts/MainLayout.astro';
import { ENGINE_COMPONENTS } from '../scripts/engine/ComponentData';

const componentsList = Object.values(ENGINE_COMPONENTS);
---

<MainLayout
  title="Four-Stroke Engine Components & Functions - Technical Specification Guide"
  description="Exhaustive mechanical component guide for 4-stroke internal combustion engines: piston, cylinder liner, connecting rod, crankshaft, valves, camshaft, spark plug, and materials."
>
  <div class="container page-header">
    <div class="breadcrumb">
      <a href="/">Home</a> / <span>Components</span>
    </div>
    <h1 style="margin-top: 0.5rem;">Internal Combustion Engine Components & Functions</h1>
    <p style="color: var(--text-muted); max-width: 720px; margin-top: 0.5rem;">
      Detailed technical definitions, mechanical functions, kinematic motions, and material specifications for all 17 primary components.
    </p>
  </div>

  <div class="container" style="padding-bottom: 3rem;">
    <div class="components-grid">
      {componentsList.map((comp) => (
        <article class="eng-card comp-full-card">
          <div class="comp-card-top">
            <h2 class="comp-title-h2">{comp.name}</h2>
            <span class="badge badge-intake">{comp.category.toUpperCase()}</span>
          </div>

          <div class="comp-details-list">
            <div>
              <span class="detail-label">Technical Definition:</span>
              <p class="detail-desc">{comp.definition}</p>
            </div>
            <div>
              <span class="detail-label">Primary Mechanical Function:</span>
              <p class="detail-desc">{comp.function}</p>
            </div>
            <div>
              <span class="detail-label">Kinematic Motion:</span>
              <p class="detail-desc">{comp.movement}</p>
            </div>
            <div>
              <span class="detail-label">Material & Specifications:</span>
              <p class="detail-desc" style="color: var(--accent-cyan);">{comp.material} — {comp.specifications}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</MainLayout>

<style>
  .page-header {
    padding: 2.5rem 1.25rem 1.5rem;
  }
  .breadcrumb {
    font-size: 0.8rem;
    color: var(--text-dim);
  }
  .breadcrumb a {
    color: var(--accent-cyan);
  }
  .components-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .comp-full-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
  }
  .comp-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
  }
  .comp-title-h2 {
    font-size: 1.15rem;
    color: var(--accent-cyan);
  }
  .comp-details-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .detail-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-dim);
    display: block;
    margin-bottom: 0.2rem;
  }
  .detail-desc {
    font-size: 0.86rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
  @media (max-width: 900px) {
    .components-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

