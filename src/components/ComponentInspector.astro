---
---

<div id="inspector-card" class="eng-card">
  <div class="eng-card-header">
    <div class="eng-card-title">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <span data-i18n="inspector_title">Interactive Component Inspector</span>
    </div>
    <div class="inspector-header-actions">
      <button id="btn-isolate-comp" class="btn btn-outline btn-sm" style="display: none;">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="16"></line>
          <line x1="8" y1="12" x2="16" y2="12"></line>
        </svg>
        <span id="label-isolate-comp" data-i18n="ctrl_isolate">Isolate Component</span>
      </button>
      <button id="btn-clear-selection" class="btn btn-outline btn-sm" style="display: none;" data-i18n="ctrl_clear">Clear</button>
    </div>
  </div>

  <!-- Empty state before clicking -->
  <div id="inspector-empty" class="inspector-empty-state">
    <div class="inspector-empty-icon">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="16" y1="13" x2="8" y2="13"></line>
        <line x1="16" y1="17" x2="8" y2="17"></line>
        <polyline points="10 9 9 9 8 9"></polyline>
      </svg>
    </div>
    <p class="inspector-prompt" data-i18n="inspector_prompt">
      Click any component in the 3D model above to inspect its engineering definition, operational role, kinematic motion, and material specifications.
    </p>
    <div class="quick-comp-pills">
      <span class="pills-title" data-i18n="inspector_quick">Quick Inspect:</span>
      <button class="comp-quick-btn" data-comp="piston" data-i18n="comp_piston">Piston</button>
      <button class="comp-quick-btn" data-comp="connectingRod" data-i18n="comp_connectingRod">Connecting Rod</button>
      <button class="comp-quick-btn" data-comp="crankshaft" data-i18n="comp_crankshaft">Crankshaft</button>
      <button class="comp-quick-btn" data-comp="intakeValve" data-i18n="comp_intakeValve">Intake Valve</button>
      <button class="comp-quick-btn" data-comp="camshaft" data-i18n="comp_camshaft">Camshaft</button>
      <button class="comp-quick-btn" data-comp="sparkPlug" data-i18n="comp_sparkPlug">Spark Plug</button>
    </div>
  </div>

  <!-- Active selected component details -->
  <div id="inspector-content" class="inspector-details" style="display: none;">
    <div class="comp-title-row">
      <h3 id="comp-name" class="comp-title">Connecting Rod</h3>
      <span id="comp-category" class="badge badge-power">Crank Mechanism</span>
    </div>

    <div class="comp-specs-grid">
      <div class="comp-spec-block">
        <span class="spec-head" data-i18n="inspector_definition">1. Engineering Definition</span>
        <p id="comp-def" class="spec-body">
          An articulated structural strut connecting the reciprocating piston pin to the rotating crankshaft crank pin.
        </p>
      </div>

      <div class="comp-spec-block">
        <span class="spec-head" data-i18n="inspector_function">2. Primary Mechanical Function</span>
        <p id="comp-func" class="spec-body">
          Converts the linear reciprocating motion of the piston into continuous rotary motion of the crankshaft while enduring severe alternating tension and compression loads.
        </p>
      </div>

      <div class="comp-spec-block">
        <span class="spec-head" data-i18n="inspector_movement">3. Kinematic Behavior & Motion</span>
        <p id="comp-move" class="spec-body">
          Complex planar motion: the small end reciprocates linearly, the big end rotates in a circle, and the shank oscillates angularly.
        </p>
      </div>

      <div class="comp-spec-block">
        <span class="spec-head" data-i18n="inspector_material">4. Material & Manufacturing Specification</span>
        <p id="comp-mat" class="spec-body">
          Forged micro-alloyed medium carbon steel (e.g. 36MnVS4) or titanium alloy in high-performance engines.
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  .inspector-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1.5rem 1rem;
    gap: 0.75rem;
  }

  .inspector-empty-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--bg-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-cyan);
  }

  .inspector-prompt {
    font-size: 0.88rem;
    color: var(--text-muted);
    max-width: 580px;
    line-height: 1.5;
  }

  .quick-comp-pills {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .pills-title {
    font-size: 0.75rem;
    color: var(--text-dim);
    font-weight: 600;
  }

  .comp-quick-btn {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    font-size: 0.75rem;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .comp-quick-btn:hover {
    color: var(--accent-cyan);
    border-color: var(--accent-cyan);
  }

  .inspector-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .comp-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .comp-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-cyan);
  }

  .comp-specs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .comp-spec-block {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.75rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .spec-head {
    font-size: 0.72rem;
    color: var(--text-dim);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .spec-body {
    font-size: 0.85rem;
    color: var(--text-main);
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .comp-specs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

