---
---

<div class="stroke-card eng-card">
  <!-- Cycle Progress Bar -->
  <div class="cycle-track-container">
    <div class="cycle-track">
      <div class="stroke-segment seg-intake">
        <span>1. INTAKE (0°-180°)</span>
      </div>
      <div class="stroke-segment seg-compression">
        <span>2. COMPRESSION (180°-360°)</span>
      </div>
      <div class="stroke-segment seg-power">
        <span>3. POWER (360°-540°)</span>
      </div>
      <div class="stroke-segment seg-exhaust">
        <span>4. EXHAUST (540°-720°)</span>
      </div>
      <!-- Needle Cursor -->
      <div id="cycle-needle" class="cycle-needle" style="left: 0%;"></div>
    </div>
  </div>

  <div class="stroke-status-content">
    <div class="stroke-badge-col">
      <div class="current-stroke-wrap">
        <span class="sub-label">CURRENT STROKE:</span>
        <div id="stroke-name-badge" class="badge badge-intake stroke-large-badge">
          1. INTAKE (SUCTION)
        </div>
      </div>
      <p id="stroke-dynamic-desc" class="stroke-desc">
        Piston is moving downward from TDC to BDC creating internal depression; fresh air-fuel mixture is entering through the open intake valve.
      </p>
    </div>

    <div class="stroke-telemetry-col">
      <!-- Spark status -->
      <div class="mini-telemetry-box" id="box-spark-status">
        <span class="mini-label">Ignition Spark</span>
        <div class="mini-val-row">
          <span id="val-spark-dot" class="status-dot dot-inactive"></span>
          <span id="val-spark-text" class="mini-value">OFF</span>
        </div>
      </div>

      <!-- Inlet valve status -->
      <div class="mini-telemetry-box">
        <span class="mini-label">Inlet Valve</span>
        <div class="mini-val-row">
          <span id="val-intake-dot" class="status-dot dot-active"></span>
          <span id="val-intake-text" class="mini-value">OPEN (4.2 mm)</span>
        </div>
      </div>

      <!-- Exhaust valve status -->
      <div class="mini-telemetry-box">
        <span class="mini-label">Exhaust Valve</span>
        <div class="mini-val-row">
          <span id="val-exhaust-dot" class="status-dot dot-inactive"></span>
          <span id="val-exhaust-text" class="mini-value">CLOSED (0.0 mm)</span>
        </div>
      </div>

      <!-- Piston direction -->
      <div class="mini-telemetry-box">
        <span class="mini-label">Piston Motion</span>
        <div class="mini-val-row">
          <span id="val-piston-dir-icon">↓</span>
          <span id="val-piston-dir" class="mini-value">Down (TDC→BDC)</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .stroke-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cycle-track-container {
    position: relative;
    width: 100%;
    padding-bottom: 0.5rem;
  }

  .cycle-track {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    height: 32px;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    overflow: hidden;
    position: relative;
  }

  .stroke-segment {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    font-family: var(--font-mono);
    border-right: 1px solid var(--border-color);
  }

  .stroke-segment:last-child {
    border-right: none;
  }

  .seg-intake {
    background: rgba(56, 189, 248, 0.12);
    color: #38bdf8;
  }
  .seg-compression {
    background: rgba(168, 85, 247, 0.12);
    color: #c084fc;
  }
  .seg-power {
    background: rgba(249, 115, 22, 0.12);
    color: #fb923c;
  }
  .seg-exhaust {
    background: rgba(245, 158, 11, 0.12);
    color: #fbbf24;
  }

  .cycle-needle {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
    background: #ffffff;
    box-shadow: 0 0 8px #ffffff;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .stroke-status-content {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 1.25rem;
    align-items: center;
  }

  .stroke-badge-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .current-stroke-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .sub-label {
    font-size: 0.72rem;
    color: var(--text-dim);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .stroke-large-badge {
    font-size: 0.95rem;
    padding: 0.35rem 0.85rem;
  }

  .stroke-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .stroke-telemetry-col {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.65rem;
  }

  .mini-telemetry-box {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.45rem 0.65rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .mini-label {
    font-size: 0.68rem;
    color: var(--text-dim);
    text-transform: uppercase;
    font-weight: 600;
  }

  .mini-val-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .mini-value {
    font-size: 0.78rem;
    font-family: var(--font-mono);
    color: var(--text-main);
    font-weight: 600;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot-active {
    background: var(--accent-green);
    box-shadow: 0 0 6px var(--accent-green);
  }

  .dot-inactive {
    background: var(--text-dim);
  }

  .dot-spark {
    background: #67e8f9;
    box-shadow: 0 0 10px #67e8f9;
    animation: spark-pulse 0.2s infinite alternate;
  }

  @keyframes spark-pulse {
    from { transform: scale(1); opacity: 0.8; }
    to { transform: scale(1.6); opacity: 1; }
  }

  @media (max-width: 850px) {
    .stroke-status-content {
      grid-template-columns: 1fr;
    }
    .stroke-telemetry-col {
      grid-template-columns: 1fr 1fr;
    }
    .cycle-track {
      font-size: 0.65rem;
    }
  }
</style>

