---
---

<section id="quiz" class="quiz-section">
  <div class="container">
    <div class="section-header">
      <span class="badge badge-power" data-i18n="quiz_badge">Interactive Assessment</span>
      <h2 data-i18n="quiz_title">Mechanical Engineering Knowledge & Challenge Quiz</h2>
      <p class="section-subtitle" data-i18n="quiz_subtitle">
        Validate your understanding of four-stroke cycle kinematics, valve events, thermodynamics, and real-time stroke identification.
      </p>
    </div>

    <!-- Mode Selector Tabs -->
    <div class="quiz-tabs-wrapper">
      <button id="tab-quiz-mcq" class="quiz-tab-btn active">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
        </svg>
        <span data-i18n="quiz_tab_mcq">Theory & Calculation Quiz</span>
      </button>

      <button id="tab-quiz-challenge" class="quiz-tab-btn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        <span data-i18n="quiz_tab_challenge">Live Stroke Identification Challenge</span>
      </button>
    </div>

    <!-- Mode 1: Multiple Choice Questions -->
    <div id="view-quiz-mcq" class="eng-card quiz-container">
      <div class="quiz-meta-header">
        <span id="quiz-progress-text" class="quiz-progress">Question 1 of 10</span>
        <div class="quiz-score-badge">
          <span data-i18n="quiz_score_prefix">Score: </span>
          <strong id="quiz-score-num">0</strong> / <span id="quiz-total-attempted">0</span>
        </div>
      </div>

      <div class="quiz-question-box">
        <h3 id="quiz-question-text" class="quiz-question-title" data-i18n="quiz_loading">Loading question...</h3>
        <div id="quiz-options-list" class="quiz-options-container">
          <!-- Dynamically populated options -->
        </div>
      </div>

      <div id="quiz-feedback-box" class="quiz-feedback" style="display: none;">
        <div id="quiz-feedback-header" class="feedback-badge">Correct!</div>
        <p id="quiz-feedback-text" class="feedback-explanation"></p>
      </div>

      <div class="quiz-action-bar">
        <button id="btn-quiz-submit" class="btn btn-primary" disabled data-i18n="quiz_submit">Submit Answer</button>
        <button id="btn-quiz-next" class="btn btn-outline" style="display: none;" data-i18n="quiz_next">Next Question →</button>
      </div>
    </div>

    <!-- Mode 2: Real-time Stroke Identification Challenge -->
    <div id="view-quiz-challenge" class="eng-card challenge-container" style="display: none;">
      <div class="challenge-instructions">
        <div class="challenge-tag" data-i18n="quiz_ch_tag">LIVE OBSERVATION CHALLENGE</div>
        <h3 data-i18n="quiz_ch_title">Identify the Current Stroke of the Running Engine</h3>
        <p data-i18n="quiz_ch_desc">
          Observe the 3D model in real time. Look at the direction of piston motion (moving down vs moving up) and observe whether the intake or exhaust valve is open off its seat. Click the correct stroke below to test your reflexes and mechanical observation!
        </p>
      </div>

      <div class="challenge-score-bar">
        <div class="challenge-stat">
          <span class="stat-lbl" data-i18n="quiz_streak">Streak:</span>
          <span id="ch-streak" class="stat-val">0</span>
        </div>
        <div class="challenge-stat">
          <span class="stat-lbl" data-i18n="quiz_score">Score:</span>
          <span id="ch-score" class="stat-val">0</span>
        </div>
        <div class="challenge-stat">
          <span class="stat-lbl" data-i18n="quiz_accuracy">Accuracy:</span>
          <span id="ch-accuracy" class="stat-val">100%</span>
        </div>
      </div>

      <div class="challenge-buttons-grid">
        <button class="btn btn-outline ch-stroke-btn seg-intake" data-stroke="intake" data-i18n="ch_btn_intake">
          1. INTAKE (Piston ↓, Inlet Open)
        </button>
        <button class="btn btn-outline ch-stroke-btn seg-compression" data-stroke="compression" data-i18n="ch_btn_compression">
          2. COMPRESSION (Piston ↑, Both Closed)
        </button>
        <button class="btn btn-outline ch-stroke-btn seg-power" data-stroke="power" data-i18n="ch_btn_power">
          3. POWER (Piston ↓, Spark/Flame)
        </button>
        <button class="btn btn-outline ch-stroke-btn seg-exhaust" data-stroke="exhaust" data-i18n="ch_btn_exhaust">
          4. EXHAUST (Piston ↑, Exhaust Open)
        </button>
      </div>

      <div id="ch-feedback" class="challenge-feedback" style="display: none;">
        <span id="ch-feedback-icon">✓</span>
        <span id="ch-feedback-msg">Correct!</span>
      </div>
    </div>
  </div>
</section>

<style>
  .quiz-section {
    padding: 3rem 0;
  }

  .section-header {
    margin-bottom: 2rem;
    text-align: center;
  }

  .section-subtitle {
    font-size: 0.95rem;
    color: var(--text-muted);
    max-width: 720px;
    margin: 0.5rem auto 0;
  }

  .quiz-tabs-wrapper {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .quiz-tab-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .quiz-tab-btn:hover {
    color: var(--text-main);
    border-color: var(--text-dim);
  }

  .quiz-tab-btn.active {
    background: var(--accent-cyan-dim);
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
  }

  .quiz-container, .challenge-container {
    max-width: 820px;
    margin: 0 auto;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .quiz-meta-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .quiz-progress {
    font-size: 0.8rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .quiz-score-badge {
    font-size: 0.85rem;
    background: var(--bg-surface);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    color: var(--accent-cyan);
  }

  .quiz-question-title {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 1.25rem;
    color: var(--text-main);
  }

  .quiz-options-container {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  :global(.quiz-option-label) {
    display: flex;
    align-items: center;
    padding: 0.85rem 1rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
    font-size: 0.88rem;
    color: var(--text-main);
    user-select: none;
  }

  :global(.quiz-option-label:hover) {
    background: var(--bg-surface-hover);
    border-color: var(--accent-cyan);
  }

  :global(.quiz-option-label.selected) {
    background: rgba(56, 189, 248, 0.15);
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
    font-weight: 600;
  }

  :global(.quiz-option-label.correct) {
    background: rgba(34, 197, 94, 0.15) !important;
    border-color: var(--accent-green) !important;
    color: #4ade80 !important;
  }

  :global(.quiz-option-label.incorrect) {
    background: rgba(244, 63, 94, 0.15) !important;
    border-color: var(--accent-red) !important;
    color: #fb7185 !important;
  }

  .quiz-feedback {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .feedback-badge {
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .feedback-badge.correct {
    background: rgba(34, 197, 94, 0.2);
    color: var(--accent-green);
    border: 1px solid var(--accent-green);
  }

  .feedback-badge.incorrect {
    background: rgba(244, 63, 94, 0.2);
    color: var(--accent-red);
    border: 1px solid var(--accent-red);
  }

  .feedback-explanation {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .quiz-action-bar {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  /* Challenge Mode Styles */
  .challenge-instructions {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .challenge-tag {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-orange);
    letter-spacing: 0.08em;
  }

  .challenge-score-bar {
    display: flex;
    justify-content: center;
    gap: 2rem;
    background: var(--bg-surface);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
  }

  .challenge-stat {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .stat-lbl {
    font-size: 0.75rem;
    color: var(--text-dim);
    text-transform: uppercase;
  }

  .stat-val {
    font-size: 1.1rem;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent-cyan);
  }

  .challenge-buttons-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .ch-stroke-btn {
    padding: 1.15rem 1rem;
    font-size: 0.95rem;
    font-weight: 700;
    border-width: 2px;
  }

  .challenge-feedback {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .challenge-feedback.correct {
    background: rgba(34, 197, 94, 0.15);
    border: 1px solid var(--accent-green);
    color: var(--accent-green);
  }

  .challenge-feedback.incorrect {
    background: rgba(244, 63, 94, 0.15);
    border: 1px solid var(--accent-red);
    color: var(--accent-red);
  }

  @media (max-width: 768px) {
    .challenge-buttons-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

