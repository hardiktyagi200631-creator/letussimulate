---
---

<div class="eng-card">
  <div class="eng-card-header">
    <div class="eng-card-title">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="2" y="3" width="20" height="14" rx="2"></rect>
        <line x1="8" y1="21" x2="16" y2="21"></line>
        <line x1="12" y1="17" x2="12" y2="21"></line>
      </svg>
      <span data-i18n="param_title">Live Mechanical & Thermodynamic Telemetry</span>
    </div>
    <span class="badge badge-intake" data-i18n="param_si_units">Calculated SI Units</span>
  </div>

  <div class="telemetry-grid">
    <!-- 1. Crankshaft Angle -->
    <div class="telemetry-cell">
      <span class="tel-label" data-i18n="param_crank_angle">Crankshaft Angle (θ)</span>
      <div class="tel-val-wrap">
        <span id="tel-crank-angle" class="tel-value">0.0</span>
        <span class="tel-unit">deg (0-720°)</span>
      </div>
    </div>

    <!-- 2. Camshaft Angle -->
    <div class="telemetry-cell">
      <span class="tel-label" data-i18n="param_cam_angle">Camshaft Angle</span>
      <div class="tel-val-wrap">
        <span id="tel-cam-angle" class="tel-value">0.0</span>
        <span class="tel-unit">deg (0-360°)</span>
      </div>
    </div>

    <!-- 3. Piston Displacement -->
    <div class="telemetry-cell">
      <span class="tel-label" data-i18n="param_piston_disp">Piston Displacement (x)</span>
      <div class="tel-val-wrap">
        <span id="tel-piston-disp" class="tel-value">0.00</span>
        <span class="tel-unit">mm (from TDC)</span>
      </div>
    </div>

    <!-- 4. Piston Velocity -->
    <div class="telemetry-cell">
      <span class="tel-label" data-i18n="param_piston_vel">Piston Velocity (v)</span>
      <div class="tel-val-wrap">
        <span id="tel-piston-vel" class="tel-value">0.00</span>
        <span class="tel-unit">m/s</span>
      </div>
    </div>

    <!-- 5. Piston Acceleration -->
    <div class="telemetry-cell">
      <span class="tel-label" data-i18n="param_piston_acc">Piston Acceleration (a)</span>
      <div class="tel-val-wrap">
        <span id="tel-piston-acc" class="tel-value">0.0</span>
        <span class="tel-unit">m/s²</span>
      </div>
    </div>

    <!-- 6. Mean Piston Speed -->
    <div class="telemetry-cell">
      <span class="tel-label" data-i18n="param_mean_speed">Mean Piston Speed (Cm)</span>
      <div class="tel-val-wrap">
        <span id="tel-mean-speed" class="tel-value">2.40</span>
        <span class="tel-unit">m/s (2LN/60)</span>
      </div>
    </div>

    <!-- 7. Cylinder Volume -->
    <div class="telemetry-cell">
      <span class="tel-label" data-i18n="param_cylinder_vol">Cylinder Volume (V)</span>
      <div class="tel-val-wrap">
        <span id="tel-cyl-vol" class="tel-value">28.9</span>
        <span class="tel-unit">cm³ (cc)</span>
      </div>
    </div>

    <!-- 8. Cylinder Pressure -->
    <div class="telemetry-cell">
      <span class="tel-label" data-i18n="param_pressure">Gas Pressure (P)</span>
      <div class="tel-val-wrap">
        <span id="tel-pressure" class="tel-value">1.01</span>
        <span class="tel-unit">bar (100 kPa)</span>
      </div>
    </div>

    <!-- 9. Gas Temperature -->
    <div class="telemetry-cell">
      <span class="tel-label" data-i18n="param_temp">Gas Temperature (T)</span>
      <div class="tel-val-wrap">
        <span id="tel-temp" class="tel-value">25.0</span>
        <span class="tel-unit">°C</span>
      </div>
    </div>

    <!-- 10. Indicated Mean Pressure -->
    <div class="telemetry-cell">
      <span class="tel-label" data-i18n="param_imep">IMEP (Mean Indicated)</span>
      <div class="tel-val-wrap">
        <span id="tel-imep" class="tel-value">8.50</span>
        <span class="tel-unit">bar</span>
      </div>
    </div>

    <!-- 11. Brake Power -->
    <div class="telemetry-cell">
      <span class="tel-label" data-i18n="param_power">Brake Power (Pb)</span>
      <div class="tel-val-wrap">
        <span id="tel-power" class="tel-value">1.64</span>
        <span class="tel-unit">kW (2.20 HP)</span>
      </div>
    </div>

    <!-- 12. Brake Torque -->
    <div class="telemetry-cell">
      <span class="tel-label" data-i18n="param_torque">Brake Torque (Tb)</span>
      <div class="tel-val-wrap">
        <span id="tel-torque" class="tel-value">13.05</span>
        <span class="tel-unit">N·m</span>
      </div>
    </div>
  </div>
</div>

<style>
  .telemetry-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.85rem;
  }

  .telemetry-cell {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .tel-label {
    font-size: 0.72rem;
    color: var(--text-dim);
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .tel-val-wrap {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    overflow: hidden;
  }

  .tel-value {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .tel-unit {
    font-size: 0.72rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
  }

  @media (max-width: 1024px) {
    .telemetry-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 680px) {
    .telemetry-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

